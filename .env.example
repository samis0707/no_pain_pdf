DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nopainpdf"

# LLM Provider configuration
# Supported providers: openai (also covers OpenAI-compatible APIs like EUrouter), anthropic
# LLM_BASE_URL is optional — set only for custom API endpoints (e.g. EUrouter, Ollama, etc.)
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4

# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-your-key-here
# LLM_MODEL=claude-3-opus-20240229

# LLM_PROVIDER=openai
# LLM_API_KEY=sk-eurouter-your-key-here
# LLM_MODEL=gemma-4
# LLM_BASE_URL=https://api.eurouter.ai/api/v1

# Docker / S3 (MinIO for local dev, Hetzner Object Storage for production)
S3_ENDPOINT=http://localhost:9000
# Endpoint the WeasyPrint container uses to fetch presigned asset URLs.
# Presigned URLs sign the Host header, so this must be the hostname that
# resolves from *inside* the pdf-service. Defaults to S3_ENDPOINT.
# Docker compose sets http://minio:9000; if Next.js runs on the host while
# pdf-service runs in Docker, use http://host.docker.internal:9000.
# S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PORT=9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=uploads
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
WEASYPRINT_URL=http://localhost:3001

# AI visual feedback: page/dpi limits for preview images fed back to the model
# PREVIEW_FEEDBACK_PAGES=3
# PREVIEW_IMAGE_DPI=96

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Legacy Supabase federation (optional): lets users of the existing
# Supabase-auth app log in here; they are migrated to local credentials on
# first login. Remove these to disable the fallback entirely.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
GHOSTSCRIPT_URL=http://localhost:3002
